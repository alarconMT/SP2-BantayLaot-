# Copy this file to .env.municipality and fill in the values for each municipality.
# IMPORTANT: MONGODB_URI must use "mongodb" (Docker service name), not "localhost".

MUNICIPALITY_ID=104305000
MUNICIPALITY_NAME=Cagayan de Oro
PORT=3001

# Docker-internal MongoDB URI — do not change the hostname "mongodb"
MONGODB_URI=mongodb://mongodb:27017/BantayLaot_104305000

# URL of the central server (Railway or self-hosted via docker-compose.central.yml)
CENTRAL_SERVER_URL=https://bantaylaot-production.up.railway.app

JWT_SECRET=your_32_char_hex_jwt_secret_here

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional: change the host port for the frontend (default 80)
# FRONTEND_PORT=8080
